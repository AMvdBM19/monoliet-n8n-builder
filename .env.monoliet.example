# ============================================
# Monoliet n8n Builder - VPS Configuration
# ============================================
# Copy to .env and fill in your values:
#   cp .env.monoliet.example .env
#
# Deploy at: /opt/docker/monoliet-n8n-builder
# Network: Docker "web" network (shared with nginx-proxy-manager)

# --------------------------------------------
# Server Configuration
# --------------------------------------------
MCP_MODE=http
NODE_ENV=production
LOG_LEVEL=info
PORT=3000
HOST=0.0.0.0

# --------------------------------------------
# Authentication (REQUIRED)
# --------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_TOKEN=

# --------------------------------------------
# Database
# --------------------------------------------
NODE_DB_PATH=/app/data/nodes.db
REBUILD_ON_START=false

# --------------------------------------------
# n8n Integration
# --------------------------------------------
# Connect to the existing n8n instance at https://n8n.monoliet.cloud
# Get API key from: n8n Settings > API > Create API Key
N8N_API_URL=https://n8n.monoliet.cloud
N8N_API_KEY=

# API timeouts
N8N_API_TIMEOUT=30000
N8N_API_MAX_RETRIES=3

# --------------------------------------------
# Telemetry
# --------------------------------------------
N8N_MCP_TELEMETRY_DISABLED=true
